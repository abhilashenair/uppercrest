Options -Indexes

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"

  <FilesMatch "^(admin-app\.html|admin-summary\.php|admin-service-worker\.js|admin-pwa-setup\.md|booking-admin\.php|blog-admin\.php|manifest\.json)$">
    Header always set X-Robots-Tag "noindex, nofollow, noarchive"
  </FilesMatch>
</IfModule>

<FilesMatch "(^\.|config\.php$|config\.example\.php$|\.sql$|\.md$|\.log$|\.env$)">
  Require all denied
</FilesMatch>

<FilesMatch "^(admin-pwa-setup\.md|booking-engine-setup\.md|booking-engine-schema\.sql|google-apps-script-bookings\.js)$">
  Require all denied
</FilesMatch>
